# Managed by Ansible. Static WASM UI only; no hardware wireless control.
# LOOPBACK default is deliberate: no public exposure without explicit change.
server {
    listen {{ et_bind_address }}:{{ et_port }};
    server_name _;
    root {{ et_document_root }};
    index index.html;
    autoindex off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "no-store" always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}
